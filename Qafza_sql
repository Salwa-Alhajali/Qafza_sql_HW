-- 3
create table enrollment(
id char(3) primary key,
student_id char(3),
cours_id char(3),
foreign key(student_id ) references student(id),
foreign key(cours_id) references course(id) ,
enrollment_deat date
);

create table session(
id char(4) primary key,
cours_id char(3),
foreign key(cours_id) references course(id) ,
session_date date
);
