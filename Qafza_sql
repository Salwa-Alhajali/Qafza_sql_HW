-- 3============
select s.id as student_id ,s.name ,c.title
from student s join 
 enrollment e on s.id =e.student_id 
 join course c on e.cours_id=c.id;
 
 -- 4============
 select se.id as session_id, c.title as course_title
 from course c
 join session se on se.cours_id=c.id
 where c.title='web';
